        $page = DB::connection('tenant')->table('pages')
            ->where('slug', $slug)
            ->where('is_active', true)
            ->where('status', 'published')
            ->first();

        abort_if(! $page, 404);

        return view("themes.{$theme}.page.show", [
            'association' => $association,
            'page' => $page,
        ]);
    }

