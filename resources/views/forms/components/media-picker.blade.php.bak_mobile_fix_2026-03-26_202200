@php
    $statePath = $getStatePath();
    $media = null;

    if ($getState()) {
        $media = \App\Models\MediaItem::query()->find($getState());
    }
@endphp

<x-dynamic-component
    :component="$getFieldWrapperView()"
    :field="$field"
>
    <div
        x-data="{
            open: false,
            tab: 'library',
            loading: false,
            uploading: false,
            items: [],
            selected: @entangle($statePath),
            selectedItem: @js($media ? [
                'id' => $media->id,
                'title' => $media->title ?: basename((string) $media->file),
                'url' => asset('storage/' . $media->file),
                'is_image' => (bool) $media->is_image,
                'extension' => $media->extension,
                'alt_text' => $media->alt_text,
            ] : null),
            search: '',
            uploadTitle: '',
            uploadAlt: '',
            uploadFile: null,
            uploadError: '',
            async loadItems() {
                this.loading = true;
                try {
                    const response = await fetch('/admin/media-library/picker-json', {
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json',
                        },
                        credentials: 'same-origin',
                    });

                    if (!response.ok) {
                        throw new Error('تعذر تحميل المكتبة');
                    }

                    this.items = await response.json();
                } catch (e) {
                    this.items = [];
                    alert(e.message || 'تعذر تحميل المكتبة');
                } finally {
                    this.loading = false;
                }
            },
            openPicker() {
                this.open = true;
                this.tab = 'library';
                this.loadItems();
            },
            chooseItem(item) {
                this.selected = item.id;
                this.selectedItem = item;
                this.open = false;
            },
            removeSelection() {
                this.selected = null;
                this.selectedItem = null;
            },
            get filteredItems() {
                const q = this.search.trim().toLowerCase();
                if (!q) return this.items;
                return this.items.filter(item =>
                    String(item.title || '').toLowerCase().includes(q) ||
                    String(item.id).includes(q) ||
                    String(item.extension || '').toLowerCase().includes(q)
                );
            },
            getCookie(name) {
                const value = `; ${document.cookie}`;
                const parts = value.split(`; ${name}=`);
                if (parts.length === 2) {
                    return decodeURIComponent(parts.pop().split(';').shift());
                }
                return '';
            },
            async uploadNow() {
                this.uploadError = '';

                if (!this.uploadFile) {
                    this.uploadError = 'اختر ملفًا أولًا';
                    return;
                }

                this.uploading = true;

                try {
                    const formData = new FormData();
                    formData.append('file', this.uploadFile);
                    formData.append('title', this.uploadTitle || '');
                    formData.append('alt_text', this.uploadAlt || '');

                    const csrfMeta = document.querySelector('meta[name=\"csrf-token\"]')?.getAttribute('content') || '';
                    const xsrfCookie = this.getCookie('XSRF-TOKEN');

                    const response = await fetch('/admin/media-library/upload', {
                        method: 'POST',
                        headers: {
                            'X-CSRF-TOKEN': csrfMeta,
                            'X-XSRF-TOKEN': xsrfCookie,
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json',
                        },
                        body: formData,
                        credentials: 'same-origin',
                    });

                    const raw = await response.text();
                    let data = {};

                    try {
                        data = JSON.parse(raw);
                    } catch (e) {
                        data = { message: raw };
                    }

                    if (!response.ok || !data.success) {
                        throw new Error(data.message || 'تعذر رفع الملف');
                    }

                    this.items.unshift(data.item);
                    this.selected = data.item.id;
                    this.selectedItem = data.item;
                    this.uploadTitle = '';
                    this.uploadAlt = '';
                    this.uploadFile = null;
                    this.tab = 'library';
                    this.open = false;
                } catch (e) {
                    this.uploadError = e.message || 'تعذر رفع الملف';
                } finally {
                    this.uploading = false;
                }
            }
        }"
        class="space-y-3"
    >
        <input type="hidden" wire:model.defer="{{ $statePath }}">

        <div class="flex flex-wrap items-center gap-3">
            <button
                type="button"
                x-on:click="openPicker()"
                class="inline-flex items-center gap-2 rounded-xl bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm"
            >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16l4.586-4.586a2 2 0 0 1 2.828 0L16 16m-2-2 1.586-1.586a2 2 0 0 1 2.828 0L20 14m-6-8h.01M6 20h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2Z"/>
                </svg>
                <span>اختيار / رفع وسائط</span>
            </button>

            <button
                type="button"
                x-show="selected"
                x-on:click="removeSelection()"
                class="inline-flex items-center gap-2 rounded-xl bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-800"
            >
                إزالة الاختيار
            </button>
        </div>

        <template x-if="selectedItem">
            <div class="rounded-2xl border border-gray-200 bg-gray-50 p-4">
                <template x-if="selectedItem.is_image">
                    <img :src="selectedItem.url" :alt="selectedItem.alt_text || selectedItem.title" class="h-36 w-36 rounded-xl border object-cover">
                </template>

                <template x-if="!selectedItem.is_image">
                    <div class="flex h-36 w-36 items-center justify-center rounded-xl border bg-white text-2xl font-bold text-red-600">
                        PDF
                    </div>
                </template>

                <div class="mt-3 text-sm font-bold text-gray-900" x-text="selectedItem.title"></div>
                <div class="mt-1 text-xs text-gray-500">
                    #<span x-text="selectedItem.id"></span>
                    —
                    <span x-text="(selectedItem.extension || 'FILE').toUpperCase()"></span>
                </div>
            </div>
        </template>

        <div
            x-show="open"
            x-cloak
            class="fixed inset-0 z-[999] pointer-events-auto flex items-center justify-center bg-black/50 p-4"
        >
            <div class="w-full max-w-6xl overflow-hidden rounded-2xl bg-white shadow-2xl" >
                <div class="flex items-center justify-between border-b px-5 py-4">
                    <div class="text-lg font-extrabold">مكتبة الوسائط</div>

                    <div class="flex items-center gap-2">
                        <button
                            type="button"
                            x-on:click="tab = 'library'"
                            :class="tab === 'library' ? 'bg-primary-600 text-white' : 'bg-gray-100 text-gray-800'"
                            class="rounded-xl px-4 py-2 text-sm font-semibold"
                        >
                            المكتبة
                        </button>

                        <button
                            type="button"
                            x-on:click="tab = 'upload'"
                            :class="tab === 'upload' ? 'bg-primary-600 text-white' : 'bg-gray-100 text-gray-800'"
                            class="rounded-xl px-4 py-2 text-sm font-semibold"
                        >
                            رفع جديد
                        </button>

                        <button
                            type="button"
                            x-on:click="open = false"
                            class="rounded-xl bg-gray-900 px-4 py-2 text-sm font-semibold text-white"
                        >
                            إغلاق
                        </button>
                    </div>
                </div>

                <div class="max-h-[80vh] overflow-auto p-5">
                    <template x-if="tab === 'library'">
                        <div class="space-y-4">
                            <input
                                type="text"
                                x-model="search"
                                placeholder="ابحث بالعنوان أو الرقم..."
                                class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm"
                            >

                            <template x-if="loading">
                                <div class="rounded-xl border border-dashed p-8 text-center text-gray-500">
                                    جاري تحميل المكتبة...
                                </div>
                            </template>

                            <template x-if="!loading && filteredItems.length === 0">
                                <div class="rounded-xl border border-dashed p-8 text-center text-gray-500">
                                    لا توجد ملفات في المكتبة
                                </div>
                            </template>

                            <div class="grid grid-cols-2 gap-4 md:grid-cols-4 xl:grid-cols-5" x-show="!loading && filteredItems.length > 0">
                                <template x-for="item in filteredItems" :key="item.id">
                                    <button
                                        type="button"
                                        x-on:click="chooseItem(item)"
                                        class="rounded-2xl border border-gray-200 bg-white p-3 text-right shadow-sm transition hover:border-primary-400 hover:shadow"
                                    >
                                        <template x-if="item.is_image">
                                            <img :src="item.url" class="mb-3 h-28 w-full rounded-xl border object-cover">
                                        </template>

                                        <template x-if="!item.is_image">
                                            <div class="mb-3 flex h-28 w-full items-center justify-center rounded-xl border bg-gray-50 text-2xl font-bold text-red-600">
                                                PDF
                                            </div>
                                        </template>

                                        <div class="text-xs font-bold text-gray-900">
                                            #<span x-text="item.id"></span>
                                        </div>
                                        <div class="mt-1 text-xs text-gray-600 break-words" x-text="item.title"></div>
                                    </button>
                                </template>
                            </div>
                        </div>
                    </template>

                    <template x-if="tab === 'upload'">
                        <div class="mx-auto max-w-2xl space-y-4">
                            <div>
                                <label class="mb-2 block text-sm font-bold">عنوان الملف</label>
                                <input type="text" x-model="uploadTitle" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm">
                            </div>

                            <div>
                                <label class="mb-2 block text-sm font-bold">النص البديل</label>
                                <input type="text" x-model="uploadAlt" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm">
                            </div>

                            <div>
                                <label class="mb-2 block text-sm font-bold">الملف</label>
                                <input
                                    type="file"
                                    x-on:change="uploadFile = $event.target.files[0] || null"
                                    accept=".jpg,.jpeg,.png,.webp,.gif,.pdf"
                                    class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm"
                                >
                            </div>

                            <template x-if="uploadError">
                                <div class="rounded-xl bg-red-50 px-4 py-3 text-sm font-medium text-red-700" x-text="uploadError"></div>
                            </template>

                            <div class="flex justify-end gap-3">
                                <button
                                    type="button"
                                    x-on:click="tab = 'library'"
                                    class="rounded-xl bg-gray-100 px-4 py-2 text-sm font-semibold text-gray-800"
                                >
                                    رجوع للمكتبة
                                </button>

                                <button
                                    type="button"
                                    x-on:click="uploadNow()"
                                    :disabled="uploading"
                                    class="rounded-xl bg-primary-600 px-4 py-2 text-sm font-semibold text-white disabled:opacity-60"
                                >
                                    <span x-show="!uploading">رفع الملف</span>
                                    <span x-show="uploading">جاري الرفع...</span>
                                </button>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>
    </div>
</x-dynamic-component>
