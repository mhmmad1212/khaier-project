@php
    $statePath = $getStatePath();

    if (request()->boolean('clear_media')) {
        $selectedId = null;
    } elseif (request()->filled('selected_media_id')) {
        $selectedId = request('selected_media_id');
    } else {
        $selectedId = $getState();
    }

    $media = null;

    if ($selectedId) {
        $media = \App\Models\MediaItem::query()->find($selectedId);
    }

    $currentUrl = url()->full();
    $previousUrl = url()->previous();
    $referer = request()->headers->get('referer');

    $returnUrl = $currentUrl;

    if (str_contains($returnUrl, '/livewire/update')) {
        if ($referer && ! str_contains($referer, '/livewire/update')) {
            $returnUrl = $referer;
        } elseif ($previousUrl && ! str_contains($previousUrl, '/livewire/update')) {
            $returnUrl = $previousUrl;
        }
    }

    $returnUrl = preg_replace('/([&?])(selected_media_id|selected_media_file|clear_media)=[^&]*/', '$1', $returnUrl);
    $returnUrl = rtrim(str_replace(['?&', '&&'], ['?', '&'], $returnUrl), '?&');

    $pickerUrl = url('/admin/media-picker') . '?' . http_build_query([
        'field' => $statePath,
        'return' => $returnUrl,
    ]);

    $clearUrl = $returnUrl . (str_contains($returnUrl, '?') ? '&' : '?') . 'clear_media=1';
    $storageKey = 'form_state_' . md5($returnUrl);
@endphp

