            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
                    @if($mainMenuItems->count())
                        @foreach($mainMenuItems as $item)
                            <li class="nav-item {{ $item->children->count() ? 'dropdown' : '' }}">
                                <a class="nav-link {{ $item->children->count() ? 'dropdown-toggle' : '' }}"
                                   href="{{ $item->children->count() ? '#' : ($item->url ?: '#') }}"
                                   @if($item->children->count()) data-bs-toggle="dropdown" @endif>
                                    @if(!empty($item->icon))
                                        <i class="bi {{ $item->icon }}"></i>
                                    @endif
                                    <span>{{ $item->title }}</span>
                                </a>

                                @if($item->children->count())
                                    <ul class="dropdown-menu">
                                        @foreach($item->children as $child)
                                            <li>
                                                <a class="dropdown-item" href="{{ $child->url ?: '#' }}">
                                                    @if(!empty($child->icon))
                                                        <i class="bi {{ $child->icon }}"></i>
                                                    @endif
                                                    <span>{{ $child->title }}</span>
                                                </a>
                                            </li>
                                        @endforeach
                                    </ul>
                                @endif
                            </li>
                        @endforeach
                    @else
                        <li class="nav-item">
