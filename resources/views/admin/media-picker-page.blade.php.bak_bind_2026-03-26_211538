<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>مكتبة الوسائط</title>

<style>
body {font-family: system-ui; background:#f5f5f5; margin:0; padding:20px;}
.grid {display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:15px;}
.card {background:#fff;border-radius:12px;padding:10px;border:1px solid #ddd;cursor:pointer;}
.card img {width:100%;height:100px;object-fit:cover;border-radius:8px;}
.btn {background:#127962;color:#fff;padding:10px 15px;border:none;border-radius:10px;cursor:pointer;}
</style>

<script>
function selectImage(id, url) {
    window.opener.postMessage({
        type: 'media-selected',
        id: id,
        url: url
    }, '*');
    window.close();
}
</script>

</head>
<body>

<h2>📁 مكتبة الوسائط</h2>

<div class="grid">
@foreach($items as $item)
    <div class="card" onclick="selectImage({{ $item->id }}, '{{ asset('storage/'.$item->file) }}')">
        @if($item->is_image)
            <img src="{{ asset('storage/'.$item->file) }}">
        @else
            <div style="height:100px;display:flex;align-items:center;justify-content:center;">PDF</div>
        @endif
        <div>#{{ $item->id }}</div>
    </div>
@endforeach
</div>

</body>
</html>
