<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>مكتبة الوسائط</title>
<style>
body{font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#f5f7fa;margin:0;padding:24px}
.wrap{max-width:1200px;margin:0 auto}
.topbar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:20px}
h2{margin:0;font-size:28px}
.search{width:min(320px,100%);border:1px solid #d1d5db;border-radius:12px;padding:12px 14px;background:#fff}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:16px}
.card{background:#fff;border-radius:16px;padding:10px;border:1px solid #e5e7eb;cursor:pointer;box-shadow:0 1px 3px rgba(0,0,0,.04);transition:.15s}
.card:hover{transform:translateY(-2px);box-shadow:0 10px 20px rgba(0,0,0,.08);border-color:#127962}
.card img{width:100%;height:120px;object-fit:cover;border-radius:12px;border:1px solid #eee;margin-bottom:8px}
.file-box{height:120px;border-radius:12px;border:1px solid #eee;margin-bottom:8px;display:flex;align-items:center;justify-content:center;background:#f8fafc;font-weight:800;color:#dc2626}
.meta-id{font-size:12px;font-weight:700;color:#111827}
.meta-title{font-size:12px;color:#6b7280;line-height:1.5;word-break:break-word;margin-top:4px}
.empty{background:#fff;border:1px dashed #d1d5db;border-radius:16px;padding:36px;text-align:center;color:#6b7280}
.toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.btn{background:#127962;color:#fff;padding:10px 14px;border:none;border-radius:12px;cursor:pointer;font-weight:700;text-decoration:none;display:inline-block}
</style>
<script>
function selectMediaFromCard(button) {
    const item = {
        id: Number(button.dataset.id),
        title: button.dataset.title,
        url: button.dataset.url,
        file: button.dataset.file,
        is_image: button.dataset.isImage === '1',
        extension: button.dataset.extension,
        alt_text: button.dataset.altText || '',
    };

    if (window.opener) {
        window.opener.postMessage({
            type: 'tenant-media-selected',
            field: @json($field),
            item: item
        }, '*');
        window.close();
    }
}

function filterCards() {
    const q = document.getElementById('media-search').value.trim().toLowerCase();
    document.querySelectorAll('.media-card').forEach(card => {
        const hay = (
            (card.dataset.title || '') + ' ' +
            (card.dataset.id || '') + ' ' +
            (card.dataset.extension || '')
        ).toLowerCase();

        card.style.display = hay.includes(q) ? '' : 'none';
    });
}
</script>
</head>
<body>
<div class="wrap">
    <div class="topbar">
        <h2>مكتبة الوسائط</h2>

        <div class="toolbar">
            <a href="{{ url('/admin/media-library/create') }}" class="btn">رفع جديد</a>
            <input id="media-search" class="search" type="text" placeholder="ابحث بالعنوان أو الرقم..." oninput="filterCards()">
        </div>
    </div>

    @if($items->isEmpty())
        <div class="empty">لا توجد ملفات في مكتبة الوسائط لهذه الجمعية.</div>
    @else
        <div class="grid">
            @foreach($items as $item)
                <button
                    type="button"
                    class="card media-card"
                    data-id="{{ $item->id }}"
                    data-title="{{ $item->title ?: basename((string) $item->file) }}"
                    data-url="{{ asset('storage/' . $item->file) }}"
                    data-file="{{ $item->file }}"
                    data-is-image="{{ $item->is_image ? '1' : '0' }}"
                    data-extension="{{ $item->extension }}"
                    data-alt-text="{{ $item->alt_text }}"
                    onclick="selectMediaFromCard(this)"
                >
                    @if($item->is_image)
                        <img src="{{ asset('storage/' . $item->file) }}" alt="{{ $item->alt_text ?: $item->title }}">
                    @else
                        <div class="file-box">PDF</div>
                    @endif

                    <div class="meta-id">#{{ $item->id }}</div>
                    <div class="meta-title">{{ $item->title ?: basename((string) $item->file) }}</div>
                </button>
            @endforeach
        </div>
    @endif
</div>
</body>
</html>
